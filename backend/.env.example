# ============================================================
#  PURVEYOLS CMS – COMPLETE ENVIRONMENT VARIABLES
# ============================================================

# ---------- SERVER ----------
PORT=5000
NODE_ENV=production

# ---------- DATABASE ----------
MONGO_URI=mongodb://localhost:27017/purveyols

# ---------- AUTHENTICATION ----------
JWT_SECRET=your_super_secret_jwt_key_here
CORS_ORIGIN=https://your-frontend-url.vercel.app

# ---------- EMAIL (Nodemailer) ----------
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password
EMAIL_FROM="Purveyols CMS <noreply@purveyols.com>"

# ---------- SMS (Africa's Talking / Twilio) ----------
# Africa's Talking
SMS_PROVIDER=africastalking
AFRICASTALKING_API_KEY=your_api_key_here
AFRICASTALKING_USERNAME=sandbox
AFRICASTALKING_SENDER_ID=PURVEYOLS

# Twilio (Alternative)
TWILIO_ACCOUNT_SID=your_account_sid
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# ---------- AI ASSISTANT (OpenAI / Gemini) ----------
AI_PROVIDER=openai
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-3.5-turbo
GEMINI_API_KEY=your_gemini_api_key_here

# ---------- AIRTEL MONEY API ----------
AIRTEL_API_URL=https://openapi.airtel.africa
AIRTEL_CLIENT_ID=your_client_id
AIRTEL_CLIENT_SECRET=your_client_secret
AIRTEL_API_KEY=your_api_key
AIRTEL_COUNTRY=ZM
AIRTEL_CURRENCY=ZMW

# ---------- MOBILE MONEY (MTN MoMo API) ----------
MTN_API_URL=https://api.mtn.com
MTN_CLIENT_ID=your_client_id
MTN_CLIENT_SECRET=your_client_secret
MTN_API_KEY=your_api_key

# ---------- GOOGLE SERVICES ----------
# For advertised projects RSS feeds
GOOGLE_API_KEY=your_google_api_key

# ---------- WEATHER API (for construction planning) ----------
WEATHER_API_KEY=your_weather_api_key
WEATHER_API_URL=https://api.openweathermap.org/data/2.5

# ---------- MAPS (for project locations) ----------
MAPS_API_KEY=your_google_maps_api_key

# ---------- NOTIFICATIONS ----------
# Push notifications (Firebase Cloud Messaging)
FCM_SERVER_KEY=your_fcm_server_key

# ---------- FILE UPLOAD (Cloudinary) ----------
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ---------- LOGGING ----------
LOG_LEVEL=info
LOG_FILE=combined.log

# ---------- CACHE ----------
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=your_redis_password

# ---------- DEPLOYMENT ----------
VERCEL_URL=https://your-app.vercel.app
RENDER_URL=https://your-backend.onrender.com

# ---------- CONSTRUCTION INDUSTRY ----------
# Construction material price API
CONSTRUCTION_MATERIALS_API_KEY=your_api_key
CONSTRUCTION_MATERIALS_API_URL=https://api.constructionmaterials.com

# Tender/RFP portals
TENDER_PORTAL_ZPPA_URL=https://www.zppa.org.zm/tenders
TENDER_PORTAL_WORLD_BANK_URL=https://projects.worldbank.org/en/projects-operations/projects-list
TENDER_PORTAL_AFDB_URL=https://www.afdb.org/en/projects-and-operations/procurement

# LinkedIn API (for job/project scraping)
LINKEDIN_CLIENT_ID=your_linkedin_client_id
LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret

# ============================================================
#  END OF ENVIRONMENT VARIABLES
# ============================================================
